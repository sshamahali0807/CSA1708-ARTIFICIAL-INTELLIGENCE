graph = {
    'A': [('B', 1), ('C', 3)],
    'B': [('D', 3), ('E', 6)],
    'C': [('F', 5)],
    'D': [],
    'E': [('G', 2)],
    'F': [('G', 2)],
    'G': []
}

heuristic = {
    'A': 7,
    'B': 6,
    'C': 4,
    'D': 5,
    'E': 2,
    'F': 1,
    'G': 0
}

open_list = ['A']
closed_list = []
g = {'A': 0}
parent = {'A': 'A'}

while open_list:
    n = open_list[0]
    for v in open_list:
        if g[v] + heuristic[v] < g[n] + heuristic[n]:
            n = v

    if n == 'G':
        path = []
        while parent[n] != n:
            path.append(n)
            n = parent[n]
        path.append('A')
        path.reverse()
        print("Path Found:", path)
        break

    open_list.remove(n)
    closed_list.append(n)

    for (m, cost) in graph[n]:
        if m not in open_list and m not in closed_list:
            open_list.append(m)
            parent[m] = n
            g[m] = g[n] + cost
        else:
            if g[m] > g[n] + cost:
                g[m] = g[n] + cost
                parent[m] = n
                if m in closed_list:
                    closed_list.remove(m)
                    open_list.append(m)
